# Copy to .env and adjust as needed: cp .env.example .env
POSTGRES_DB=mwgshop
POSTGRES_USER=mwg
POSTGRES_PASSWORD=mwg_secret
# Host port mapped to the container's 5432 (5432 is often taken by local Postgres)
POSTGRES_PORT=55432
ADMINER_PORT=58080
TZ=Asia/Ho_Chi_Minh

# Qwen Image Edit Gateway (đọc bởi docker compose)
QWEN_GATEWAY_URL=https://ai.itmwg.vn/ai-mwg/qwen-edit-image
QWEN_API_KEY=mwg-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
QWEN_GATEWAY_TIMEOUT_S=60.0
QWEN_GATEWAY_CONNECT_TIMEOUT_S=10.0
AUTO_GENERATE_IMAGE=false

# Tham số gợi ý
PRODUCTS_PER_GROUP=3
