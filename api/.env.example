# Nạp model Grounding DINO (Zero-Shot, Apache-2.0) qua Hugging Face `transformers`.
# Có thể truyền Hugging Face model ID hoặc đường dẫn tới thư mục snapshot cục bộ.
MODEL_PATH=IDEA-Research/grounding-dino-tiny
MODEL_DEVICE=auto
MODEL_CONFIDENCE=0.3
MODEL_TEXT_THRESHOLD=0.25
DETECT_JPEG_ROUNDTRIP=true
# Bộ class chuẩn của detector phải khớp `cooccurrence_matrix.json`.
REQUIRE_CLASS_MATCH=true

# Cell 10.3/10.5 — ma trận đồng xuất hiện đã học từ COCO train.
# Thiếu file này thì API không khởi động được (không có dự phòng).
COOCCURRENCE_MATRIX_PATH=artifacts/matrix/cooccurrence_matrix.json
# Cell 10.7 — bảng điểm phòng W(c, r), khoá theo TÊN nhóm hiển thị ("TV", "Loa"…).
# Thiếu file này thì API không khởi động được (không có dự phòng).
CATEGORY_ROOM_SCORES_PATH=artifacts/matrix/category_room_scores.json

# Catalog sản phẩm: CHỈ PostgreSQL schema `mwg` (3 bảng: product, categories, brand).
# Không còn fallback CSV — DB không tới được là API báo lỗi và dừng khởi động.
DB_HOST=127.0.0.1
DB_PORT=55432
DB_NAME=mwgshop
DB_USER=mwg
DB_PASSWORD=mwg_secret
DB_SCHEMA=mwg

# Tham số gợi ý (Cell 10.1)
DEFAULT_ROOM_TYPE=living_room
DEFAULT_TOP_K=10
DEFAULT_MIN_SCORE=0.05
PRODUCTS_PER_GROUP=3
ALPHA_SMOOTH=1.0
SMOOTH_K=2

# Qwen Image Edit Gateway (ghép sản phẩm vào phòng qua /v1/images/edits)
QWEN_GATEWAY_URL=https://ai.itmwg.vn/ai-mwg/qwen-edit-image
QWEN_API_KEY=mwg-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
QWEN_GATEWAY_TIMEOUT_S=60.0
QWEN_GATEWAY_CONNECT_TIMEOUT_S=10.0
QWEN_MAX_CONCURRENT_EDITS=2
DETECT_SHORTEST_EDGE=512
DETECT_LONGEST_EDGE=768
AUTO_GENERATE_IMAGE=false


LOG_LEVEL=INFO
# Bật Swagger UI (/docs), ReDoc (/redoc) và /openapi.json. Production: false.
DOCS_ENABLED=true
MAX_UPLOAD_MB=10

# --- Chỉ dùng cho docker compose ---
# Cổng trên máy host map vào 8000 của container.
API_PORT=8000
